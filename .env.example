PORT=8000
HOST=0.0.0.0

# 简历解析 LLM。兼容 OpenAI SDK 的网关可直接使用 /v1 地址。
RESUME_LLM_API_KEY=your_api_key_here
RESUME_LLM_BASE_URL=https://ai-gateway.ailab.jiuan.com/v1
RESUME_LLM_MODEL=gpt-4o-mini

# 兼容旧 README 的 DashScope 变量，未设置 RESUME_LLM_API_KEY 时会自动回退到它。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 人才画像模块。前端仍传 API Key，Base URL 和 Model 可在这里切换到兼容网关。
PORTRAIT_LLM_BASE_URL=https://ai-gateway.ailab.jiuan.com/v1
PORTRAIT_LLM_MODEL=gpt-4o-mini

# 面试模块默认配置；也可以在前端“AI 面试 -> 大语言模型配置”中保存到 .env.json。
LLM_PROVIDER=openai
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://ai-gateway.ailab.jiuan.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# ── 阿里云智能语音交互 (NLS) 配置 ──
# 当前仅用于 ASR（语音识别）
# 开通地址: https://nls.console.aliyun.com
# 获取方式:
#   1. AccessKeyId / AccessKeySecret: RAM 用户凭证
#   2. AppKey: NLS 控制台创建项目后获取
ALIYUN_NLS_AK_ID=your_access_key_id
ALIYUN_NLS_AK_SECRET=your_access_key_secret
ALIYUN_NLS_APP_KEY=your_app_key
ALIYUN_NLS_REGION=cn-shanghai


 {
    "api_key": "your_interview_llm_api_key",
    "base_url": "https://api.deepseek.com/v1",
    "model": "deepseek-chat",
    "provider": "deepseek",
    "temperature": 0.7,
    "max_tokens": 2048,

    "aliyun_nls": {
      "access_key_id": "your_aliyun_access_key_id",
      "access_key_secret": "your_aliyun_access_key_secret",
      "app_key": "your_aliyun_nls_app_key",
      "region": "cn-shanghai"
    },

    "interview_tts": {
      "provider": "mimo",
      "fallback_provider": "",
      "mimo": {
        "api_key": "your_new_mimo_api_key",
        "base_url": "https://token-plan-cn.xiaomimimo.com/v1",
        "model": "mimo-v2.5-tts",
        "voice": "mimo_default",
        "format": "wav"
      }
    }
  }
