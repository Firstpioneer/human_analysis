# 简历模块 LLM 配置（阿里云 DashScope）
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 面试引擎 LLM 配置（可选，也可通过前端配置）
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_PROVIDER=deepseek
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# ── 阿里云智能语音交互 (NLS) 配置 ──
# 用于 TTS（文字转语音）和 ASR（语音识别）
# 开通地址: https://nls.console.aliyun.com
# 获取方式:
#   1. AccessKeyId / AccessKeySecret: RAM 用户凭证
#   2. AppKey: NLS 控制台创建项目后获取
ALIYUN_NLS_AK_ID=your_access_key_id
ALIYUN_NLS_AK_SECRET=your_access_key_secret
ALIYUN_NLS_APP_KEY=your_app_key
ALIYUN_NLS_REGION=cn-shanghai
